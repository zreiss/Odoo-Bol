<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_epa_user" model="res.groups">
        <field name="name">EPA Account Entry and Review</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_epa_manager" model="res.groups">
        <field name="name">EPA Account Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_epa_user'))]"/>
    </record>
    <record id="sales_team.group_sale_salesman" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_epa_user'))]"/>
    </record>
    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_epa_manager'))]"/>
    </record>
    <record id="rule_epa_company" model="ir.rule">
        <field name="name">EPA files: allowed companies</field>
        <field name="model_id" ref="model_ehs_epa_credential"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
